extends State
class_name Motion

signal velocity_updated(vel: Vector3)
#a signal that updates the velocity to a vector 3

var speed: float
var sprint_speed: float
var aim_speed: float
var jump_velocity: float
var jump_gravity: float
var fall_gravity: float
#variables that are declared in the movement stats, NOT STATES

static var input_dir: Vector2 = Vector2.ZERO
static var direction: Vector3 = Vector3.ZERO
static var sprint_remaining: float = 0.0
static var velocity: Vector3 = Vector3.ZERO
static var sprint_recharge_delay_remaining: float = 0
#static variables that are mostly vectors that shouldn't be modified

const EM_MOVEMENT_STATS = preload("res://Eric Morrow/EM_movement_stats.tres")
#a constant variable that lets the movement stats be the resource of all the variables inside the movement stats script

func _ready() -> void:
	velocity_updated.connect(owner.set_velocity_from_motion)
	sprint_remaining = EM_MOVEMENT_STATS.sprint_duration
	speed = EM_MOVEMENT_STATS.get_velocity(EM_MOVEMENT_STATS.jump_distance, EM_MOVEMENT_STATS.time_to_jump_apex + EM_MOVEMENT_STATS.time_to_land)
	sprint_speed = EM_MOVEMENT_STATS.get_velocity(EM_MOVEMENT_STATS.sprint_jump_distance, EM_MOVEMENT_STATS.time_to_jump_apex + EM_MOVEMENT_STATS.time_to_land)
	aim_speed = EM_MOVEMENT_STATS.get_velocity(EM_MOVEMENT_STATS.aim_jump_distance, EM_MOVEMENT_STATS.time_to_jump_apex + EM_MOVEMENT_STATS.time_to_land)
	jump_gravity = EM_MOVEMENT_STATS.get_jump_gravity()
	fall_gravity = EM_MOVEMENT_STATS.get_fall_gravity()
	jump_velocity = EM_MOVEMENT_STATS.get_jump_velocity(jump_gravity)
#delcaring and setting the variables to their movement stats equivalent

func set_direction() -> void:
	input_dir = Input.get_vector("walk_left", "walk_right", "walk_forward", "walk_back")
	direction = (owner.global_transform.basis * Vector3(input_dir.x, 0.0, input_dir.y)).normalized()
#sets the direction to the inputs and a normalized vector

func calculate_velocity(_speed: float, _direction: Vector3, acceleration: float, delta: float) -> void:
	velocity.x = move_toward(velocity.x, _direction.x * _speed, acceleration * delta)
	velocity.z = move_toward(velocity.z, _direction.z * _speed, acceleration * delta)
	velocity_updated.emit(velocity)
#the velocity is calculated here and the emitted once updated

func calculate_gravity(delta: float) -> void:
	if not owner.is_on_floor():
		if velocity.y > 0:
			velocity.y -= jump_gravity * delta
		else:
			velocity.y -= fall_gravity * delta
#calculates gravity

func is_on_floor() -> bool:
	return owner.is_on_floor()
#detects if the character is on the ground

func _replenish_sprint(delta: float) -> void:
	if sprint_recharge_delay_remaining >= 0.0:
		sprint_recharge_delay_remaining -= delta
	else:
		sprint_remaining = min(sprint_remaining + delta, EM_MOVEMENT_STATS.sprint_duration)
#recharges the sprint speed once draining everything
