extends Motion

@export var sprint_recharge_delay: float = 2.0

signal sprint_started
signal sprint_ended

func _enter() -> void:
	sprint_started.emit()
	print(name)
	sprint_recharge_delay_remaining = sprint_recharge_delay

func _state_input(event: InputEvent) -> void:
	if event.is_action_pressed("jump"):
		finished.emit("SprintJump")
	
	if event.is_action_released("sprint"):
		sprint_ended.emit()
		finished.emit("Run")

func _update(delta: float) -> void:
	set_direction()
	calculate_velocity(sprint_speed, direction, EM_MOVEMENT_STATS.acceleration, delta)
	
	sprint_remaining -= delta
	if sprint_remaining <= 0.0:
		sprint_ended.emit()
		finished.emit("Run")
	
	if direction == Vector3.ZERO:
		sprint_ended.emit()
		finished.emit("Idle")
